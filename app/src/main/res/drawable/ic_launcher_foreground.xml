            <gradient
                android:endX="68"
                android:endY="75"
                android:startX="40"
                android:startY="35"
                android:type="linear">
                <item android:color="#54D2F2" android:offset="0" />
                <item android:color="#FFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Accent Dot -->
    <path
        android:fillColor="#54D2F2"
